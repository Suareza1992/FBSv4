  "sameRoutine": [
    { "label": "case and extra spaces do not break a match",       "a": "push", "b": "pushSpaced",          "same": true },
    { "label": "generated item ids are not part of the routine",   "a": "pushWarmupItemA", "b": "pushWarmupItemB", "same": true },
    { "label": "a day's nutrition is not part of the routine",     "a": "push", "b": "pushWithNutrition",   "same": true },
    { "label": "a demo video makes two days different",            "a": "push", "b": "pushWithVideoWeb",    "same": false },
    { "label": "the phone's videoUrl counts the same as the web's video", "a": "pushWithVideoWeb", "b": "pushWithVideoPhone", "same": true },
    { "label": "a warmup item IS part of the routine",             "a": "push", "b": "pushWarmupItemA",     "same": false },
