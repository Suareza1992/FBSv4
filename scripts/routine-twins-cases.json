    { "label": "a cooldown item alone is content",   "day": "cooldownItemOnly", "expect": true  },
    { "label": "an empty object is blank",           "day": "blank",            "expect": false },
    { "label": "a name alone is blank",              "day": "nameOnly",         "expect": false },
    { "label": "whitespace is blank",                "day": "whitespace",       "expect": false }
