  "plan": [
    {
      "label": "the edit is carried to the other weeks",
      "weeks": [{ "1": "push", "4": "legs", "6": "rest", "7": "rest" }, { "1": "push", "4": "legs" }, { "1": "push", "4": "legs" }, { "1": "push", "4": "legs" }],
      "editWeek": 0, "editDay": "1", "before": "push", "after": "pushEdited",
      "offer": true, "twins": ["1:1", "2:1", "3:1"]
    },
    {
      "label": "a day already changed on purpose is never touched",
      "weeks": [{ "1": "push" }, { "1": "push" }, { "1": "pushTailored" }, { "1": "push" }],
      "editWeek": 0, "editDay": "1", "before": "push", "after": "pushEdited",
      "offer": true, "twins": ["1:1", "3:1"]
    },
    {
      "label": "a day already holding the new version is not offered",
      "weeks": [{ "1": "push" }, { "1": "push" }, { "1": "pushEdited" }],
      "editWeek": 0, "editDay": "1", "before": "push", "after": "pushEdited",
      "offer": true, "twins": ["1:1"]
    },
    {
      "label": "filling a blank day offers nothing",
      "weeks": [{ "1": "push", "3": "blank" }, { "1": "push", "3": "blank" }],
      "editWeek": 0, "editDay": "3", "before": "blank", "after": "push",
      "offer": false, "twins": []
    },
    {
      "label": "saving an unchanged day asks nothing",
      "weeks": [{ "1": "push" }, { "1": "push" }],
      "editWeek": 0, "editDay": "1", "before": "push", "after": "push",
      "offer": false, "twins": []
    },
    {
      "label": "editing leg day finds only the leg days",
      "weeks": [{ "1": "push", "4": "legs" }, { "1": "push", "4": "legs" }, { "1": "push", "4": "legs" }],
      "editWeek": 0, "editDay": "4", "before": "legs", "after": "legsEdited",
      "offer": true, "twins": ["1:4", "2:4"]
    },
    {
      "label": "a one-week program offers nothing",
      "weeks": [{ "1": "push" }],
      "editWeek": 0, "editDay": "1", "before": "push", "after": "pushEdited",
      "offer": false, "twins": []
    },
    {
      "label": "a program with no weeks offers nothing",
      "weeks": [],
      "editWeek": 0, "editDay": "1", "before": "push", "after": "pushEdited",
      "offer": false, "twins": []
    },
    {
      "label": "a spacing-only difference still counts as the same routine",
      "weeks": [{ "1": "push" }, { "1": "pushSpaced" }],
      "editWeek": 0, "editDay": "1", "before": "push", "after": "pushEdited",
      "offer": true, "twins": ["1:1"]
    },
    {
      "label": "a copy carrying a demo video is left alone",
      "weeks": [{ "1": "push" }, { "1": "pushWithVideoWeb" }, { "1": "push" }],
      "editWeek": 0, "editDay": "1", "before": "push", "after": "pushEdited",
      "offer": true, "twins": ["2:1"]
    },
    {
      "label": "rest days are copies too",
      "weeks": [{ "6": "rest" }, { "6": "rest" }, { "6": "activeRest" }],
      "editWeek": 0, "editDay": "6", "before": "rest", "after": "activeRest",
      "offer": true, "twins": ["1:6"]
    },
    {
      "label": "the same routine on a different weekday is still a copy",
      "weeks": [{ "1": "push", "5": "push" }, { "1": "push" }],
      "editWeek": 0, "editDay": "1", "before": "push", "after": "pushEdited",
      "offer": true, "twins": ["0:5", "1:1"]
